{
  "name": "oden-agent",
  "version": "1.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaiju-no-9/oden.git"
  },
  "type": "module",
  "bin": { "oden": "bin/oden.js" },
  "engines": { "node": ">=20.17.0" },
  "files": [
    "bin/oden.js",
    "dist/",
    "assets/oden-terminal-logo.png",
    "docker-compose.yaml",
    "sandbox.Dockerfile",
    "README.md"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "build": "node scripts/clean-build.mjs && tsc --project tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "2.28.0",
    "@inquirer/prompts": "8.7.3",
    "@tavily/core": "0.7.14",
    "chalk": "5.6.2",
    "commander": "15.0.0",
    "zod": "4.6.5"
  },
  "optionalDependencies": {
    "keytar": "7.9.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "bun-types": "1.4.2",
    "typescript": "7.0.2"
  }
}
