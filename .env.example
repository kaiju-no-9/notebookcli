
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Default provider: openrouter or gemini.
ODEN_PROVIDER=openrouter
# Default project root (CLI --workspace overrides this).
# ODEN_WORKSPACE=/absolute/path/to/project

# Per-user-turn budgets shared across classifiers, routing, agents, tools, and streaming.
ODEN_MAX_LLM_REQUESTS=24
ODEN_MAX_TOOL_INVOCATIONS=40
ODEN_MAX_RUN_DURATION_MS=180000
ODEN_MAX_RUN_TOKENS=65536
ODEN_MAX_OUTPUT_TOKENS=2048
ODEN_MAX_RETRIES=2
ODEN_MAX_RETRY_DELAY_MS=5000


# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_GUARD_MODEL=openrouter/free
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_GUARD_MODEL=gemini-3.5-flash-lite

# Optional search and memory integrations.
# TAVILY_API_KEY=
# MEMORY_API_URL=https://api.supermemory.ai/v3
# SUPERMEMORY_API_KEY=  # Supermemory uses Bearer authentication
